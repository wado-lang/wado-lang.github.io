//! A rendered post: front-matter metadata plus the Marl-rendered body.

use { render } from "./markdown.wado";
use { parse } from "./front_matter.wado";

pub struct Post {
    pub slug: String,
    pub title: String,
    pub date: String,
    pub author: String,
    pub description: String,
    pub body_md: String,
    pub body_html: String,
    pub index: bool,
}

/// Build a post from its slug (typically the file stem) and source document.
pub fn build(slug: String, source: &String) -> Result<Post, String> {
    let [fm, body] = parse(source)?;
    return Result::Ok(Post {
        slug,
        title: fm.title,
        date: fm.date,
        author: fm.author,
        description: fm.description,
        body_md: body,
        body_html: render(body),
        index: fm.index,
    });
}

/// The listed posts, newest first. `"index": false` keeps a post out of every
/// listing.
pub fn listed(posts: &List<Post>) -> List<Post> {
    let mut out: List<Post> = [];
    for let p of posts {
        if p.index {
            out.push(*p);
        }
    }
    out.sort_by(|a: &Post, b: &Post| b.date.cmp(&a.date));
    return out;
}

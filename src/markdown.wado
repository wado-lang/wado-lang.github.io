//! The single Marl import site: binds Marl's `RenderHook` to
//! `highlight_provider.wado`.

use { Marl } from "wado-lang:marl" with { provider: "./highlight_provider.wado" };

/// Render Markdown to HTML, syntax-highlighting fenced code blocks and keeping
/// comments.
pub fn render(source: String) -> String {
    return Marl::render_highlighted(source).html;
}

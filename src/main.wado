use { println, eprintln, exit_error, Stdout, Stderr, Exit } from "core:cli";
use fs from "core:fs";
use { Preopens } from "wasi:filesystem";
use { build, Post } from "./post.wado";
use { build_doc, Doc } from "./doc.wado";
use { build_site, build_docs, build_llms, SiteFile } from "./site.wado";
use { check_links } from "./linkcheck.wado";

global CONTENT_DIR: String = "content";
global DOCS_DIR: String = ".tmp/wado/docs";
global OUT_DIR: String = "_site";

/// Why the run stopped, ready to print. Every failure reaches `run` as one.
type BuildError = String;

/// `FsError` already names the path it failed on, so `?` adds no context.
impl From<fs::FsError> for BuildError {
    fn from(value: fs::FsError) -> BuildError {
        return `${value}`;
    }
}

export fn run() with (Stdout, Stderr, Preopens, Exit) {
    if let Err(e) = generate() {
        eprintln(`sheaf: ${e}`);
        exit_error();
    }
}

/// Generate the whole site. Any unreadable input or unwritable output fails the
/// run: a half-generated site that exits 0 is one the deploy would publish.
fn generate() -> Result<(), BuildError> with (Stdout, Stderr, Preopens) {
    let posts = read_posts()?;
    let docs = read_docs()?;
    let mut files = build_site(&posts);
    files.extend(&build_docs(&docs));
    files.push(build_llms(&posts, &docs));
    write_site(&files)?;
    println(`sheaf: generated ${files.len()} file(s) from ${posts.len()} post(s) and ${docs.len()} doc(s)`);
    report_broken_links(&files);
    return Result::Ok(());
}

fn read_posts() -> Result<List<Post>, BuildError> with Preopens {
    let mut posts: List<Post> = [];
    for let [name, source] of read_markdown(&CONTENT_DIR, &[])? {
        match build(slug_of(&name), &source) {
            Ok(post) => posts.push(post),
            Err(e) => {
                return Result::Err(`${name}: ${e}`);
            },
        }
    }
    return Result::Ok(posts);
}

fn read_docs() -> Result<List<Doc>, BuildError> with Preopens {
    let mut docs: List<Doc> = [];
    // `CLAUDE.md` is a symlink upstream, so the two must be excluded before the
    // read: following it out of the preopened tree fails.
    for let [name, source] of read_markdown(&DOCS_DIR, &["AGENTS.md", "CLAUDE.md"])? {
        docs.push(build_doc(slug_of(&name), &source));
    }
    return Result::Ok(docs);
}

fn slug_of(name: &String) -> String {
    let Some(slug) = name.strip_suffix(".md") else {
        panic(`not a Markdown file: ${name}`);
    };
    return slug;
}

/// Every `*.md` in `dir` except the excluded names, as `[name, source]`.
fn read_markdown(dir: &String, exclude: &List<String>) -> Result<List<[String, String]>, BuildError> with Preopens {
    let mut out: List<[String, String]> = [];
    for let entry of fs::read_dir(dir)? {
        if !entry.name.ends_with(".md") || exclude.contains(&entry.name) {
            continue;
        }
        out.push([entry.name, fs::read_to_string(&`${dir}/${entry.name}`)?]);
    }
    return Result::Ok(out);
}

fn write_site(files: &List<SiteFile>) -> Result<(), BuildError> with Preopens {
    fs::create_dir_all(&`${OUT_DIR}/docs`)?;
    for let f of files {
        fs::write(&`${OUT_DIR}/${f.path}`, &f.content)?;
    }
    return Result::Ok(());
}

/// Broken internal links are a warning, never a failure: they are typically
/// typos in the upstream docs, which this repository cannot fix.
fn report_broken_links(files: &List<SiteFile>) with Stderr {
    let broken = check_links(files);
    if broken.is_empty() {
        return;
    }
    eprintln(`sheaf: warning: ${broken.len()} broken internal link(s):`);
    for let b of broken {
        eprintln(`  ${b.page} -> ${b.target}`);
    }
}

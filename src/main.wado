use { println, eprintln, Stdout, Stderr } from "core:cli";
use fs from "core:fs";
use { Preopens } from "wasi:filesystem";
use { build, Post } from "./post.wado";
use { build_doc, Doc } from "./doc.wado";
use { build_site, build_docs, build_llms, SiteFile } from "./site.wado";
use { check_links } from "./linkcheck.wado";

global CONTENT_DIR: String = "content";
global DOCS_DIR: String = ".tmp/wado/docs";
global OUT_DIR: String = "_site";

export fn run() with (Stdout, Stderr, Preopens) {
    let posts = read_posts();
    let docs = read_docs();
    let mut files = build_site(&posts);
    files.extend(&build_docs(&docs));
    files.push(build_llms(&posts, &docs));
    write_site(&files);
    println(`sheaf: generated ${files.len()} file(s) from ${posts.len()} post(s) and ${docs.len()} doc(s)`);
    report_broken_links(&files);
}

fn report_broken_links(files: &List<SiteFile>) with Stderr {
    let broken = check_links(files);
    if broken.is_empty() {
        return;
    }
    eprintln(`sheaf: warning: ${broken.len()} broken internal link(s):`);
    for let b of broken {
        eprintln(`  ${b.page} -> ${b.target}`);
    }
}

fn read_posts() -> List<Post> with (Stderr, Preopens) {
    let mut posts: List<Post> = [];
    for let [name, source] of read_markdown(&CONTENT_DIR, &[]) {
        let Some(slug) = name.strip_suffix(".md") else {
            continue;
        };
        match build(slug, &source) {
            Ok(post) => posts.push(post),
            Err(e) => eprintln(`sheaf: ${name}: ${e}`),
        }
    }
    return posts;
}

fn read_docs() -> List<Doc> with (Stderr, Preopens) {
    let mut docs: List<Doc> = [];
    // `CLAUDE.md` is a symlink to `AGENTS.md` upstream, so excluding the two by
    // name before the read is also what keeps the walk off a link it cannot
    // follow out of the preopened tree.
    for let [name, source] of read_markdown(&DOCS_DIR, &["AGENTS.md", "CLAUDE.md"]) {
        let Some(slug) = name.strip_suffix(".md") else {
            continue;
        };
        docs.push(build_doc(slug, &source));
    }
    return docs;
}

/// Every `*.md` in `dir` except the excluded names, as `[name, source]`. A
/// directory that cannot be read is reported and yields nothing, so one missing
/// input does not stop the rest.
fn read_markdown(dir: &String, exclude: &List<String>) -> List<[String, String]> with (Stderr, Preopens) {
    let mut out: List<[String, String]> = [];
    let entries = match fs::read_dir(dir) {
        Ok(e) => e,
        Err(e) => {
            eprintln(`sheaf: ${e}`);
            return out;
        },
    };
    for let entry of entries {
        if !entry.name.ends_with(".md") || exclude.contains(&entry.name) {
            continue;
        }
        match fs::read_to_string(&`${dir}/${entry.name}`) {
            Ok(source) => out.push([entry.name, source]),
            Err(e) => eprintln(`sheaf: ${e}`),
        }
    }
    return out;
}

fn write_site(files: &List<SiteFile>) with (Stderr, Preopens) {
    if let Err(e) = fs::create_dir_all(&`${OUT_DIR}/docs`) {
        eprintln(`sheaf: ${e}`);
        return;
    }
    for let f of files {
        if let Err(e) = fs::write(&`${OUT_DIR}/${f.path}`, &f.content) {
            eprintln(`sheaf: ${e}`);
        }
    }
}

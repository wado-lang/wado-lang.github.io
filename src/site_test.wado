use { build_site, build_docs, build_llms } from "./site.wado";
use { build_doc } from "./doc.wado";
use { Post } from "./post.wado";

fn sample_posts() -> List<Post> {
    return [
        Post { slug: "hello", title: "Hello", date: "2026-03-01", author: "FUJI Goro", description: "", body_md: "hi", body_html: "<p>hi</p>", index: true },
        Post { slug: "wip", title: "WIP", date: "2026-04-01", author: "FUJI Goro", description: "", body_md: "wip", body_html: "<p>wip</p>", index: false },
    ];
}

test "build_site emits an HTML page per post, a Markdown copy of the listed ones, and an index" {
    let files = build_site(&sample_posts());
    assert files.len() == 4;
    assert files[0].path == "hello.html";
    assert files[1].path == "hello.md";
    assert files[2].path == "wip.html";
    assert files[3].path == "index.html";

    assert files[2].content.contains("noindex");
    assert files[3].content.contains("hello.html");
    assert !files[3].content.contains("wip.html");
}

test "the Markdown copy of a post carries the heading and byline in place of front matter" {
    let files = build_site(&sample_posts());
    assert files[1].content == "# Hello\n\nFUJI Goro · 2026-03-01\n\nhi\n";
}

test "build_docs emits a Markdown copy of the upstream source verbatim" {
    let source = "# Spec\n\nIntro.\n";
    let files = build_docs(&[build_doc("spec", &source)]);
    assert files.len() == 3;
    assert files[0].path == "docs/spec.html";
    assert files[1].path == "docs/spec.md";
    assert files[1].content == source;
    assert files[2].path == "docs/index.html";
}

test "build_llms writes llms.txt at the blog root" {
    let file = build_llms(&sample_posts(), &[build_doc("cheatsheet", &"# Wado Cheatsheet\n")]);
    assert file.path == "llms.txt";
    assert file.content.starts_with("# Wado\n");
}

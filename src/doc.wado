//! A rendered reference doc: an upstream `docs/*.md` from the Wado repo, carrying
//! no front matter, with its relative `.md` links rewritten to `.html`.

use { render } from "./markdown.wado";

internal global SUMMARY_MAX: i32 = 200;

pub struct Doc {
    pub slug: String,
    pub title: String,
    pub summary: String,
    pub source: String,
    pub body_html: String,
}

/// How a doc is filed on the index and in `llms.txt`, decided by its slug.
pub enum DocGroup {
    Reference,
    Wep,
    Stdlib,
    Research,
    Other,
}

pub fn group_of(slug: &String) -> DocGroup {
    if *slug == "spec" || *slug == "cheatsheet" || *slug == "design-philosophy" {
        return DocGroup::Reference;
    }
    if slug.starts_with("wep-") {
        return DocGroup::Wep;
    }
    if slug.starts_with("stdlib-") {
        return DocGroup::Stdlib;
    }
    if slug.starts_with("research-") {
        return DocGroup::Research;
    }
    return DocGroup::Other;
}

/// The docs filed under one group, slug-sorted.
pub fn in_group(docs: &List<Doc>, group: DocGroup) -> List<Doc> {
    let mut out: List<Doc> = [];
    for let d of docs {
        if group_of(&d.slug) == group {
            out.push(*d);
        }
    }
    out.sort_by(|a: &Doc, b: &Doc| a.slug.cmp(&b.slug));
    return out;
}

pub fn build_doc(slug: String, source: &String) -> Doc {
    let title = extract_title(source, &slug);
    let summary = extract_summary(source);
    let rendered = render(*source);
    let body_html = rewrite_md_links(&rendered);
    return Doc { slug, title, summary, source: *source, body_html };
}

/// The first sentence of the paragraph after the level-1 heading. Empty when a
/// subsection follows the heading directly.
fn extract_summary(source: &String) -> String {
    let joined = strip_links(&lead_paragraph(source));
    let shortened = shorten(&first_sentence(&joined));
    let trimmed = shortened.trim_end();
    // A lead-in ending in a colon introduces a list the summary does not carry.
    return match trimmed.strip_suffix(":") {
        Some(t) => t.trim_end(),
        None => trimmed,
    };
}

fn lead_paragraph(source: &String) -> String {
    let mut seen_title = false;
    let mut parts: List<String> = [];
    for let line of source.lines() {
        let t = line.trim();
        if !seen_title {
            if t.starts_with("# ") {
                seen_title = true;
            }
            continue;
        }
        if t.is_empty() {
            if parts.is_empty() {
                continue;
            }
            break;
        }
        if t.starts_with("#") || t.starts_with("<!--") || t.starts_with("```") {
            break;
        }
        parts.push(t);
    }
    return parts.join(" ");
}

fn first_sentence(s: &String) -> String {
    return match s.find(". ") {
        Some(i) => s.substr_bytes(0, i + 1),
        None => *s,
    };
}

fn shorten(s: &String) -> String {
    if s.len() <= SUMMARY_MAX {
        return *s;
    }
    let head = truncate_bytes(s, SUMMARY_MAX);
    let cut = match head.rfind(" ") {
        Some(i) => head.substr_bytes(0, i),
        None => head,
    };
    return `${cut}…`;
}

/// The longest prefix of `s` within `limit` bytes that does not split a
/// character. `substr_bytes` panics on an index that is not a UTF-8 boundary.
fn truncate_bytes(s: &String, limit: i32) -> String {
    let mut end = limit;
    while !s.is_char_boundary(end) {
        end -= 1;
    }
    assert end >= 0;
    return s.substr_bytes(0, end);
}

/// Replace `[text](url)` and a bare `[text]` reference with `text`: a summary is
/// republished at a path the doc's relative links do not resolve from.
fn strip_links(s: &String) -> String {
    let mut out = String::new();
    let mut rest = *s;
    loop {
        let Some(open) = rest.find("[") else {
            out.push_str(&rest);
            return out;
        };
        let after_open = rest.substr_bytes(open + 1, rest.len());
        let Some(close_bracket) = after_open.find("]") else {
            out.push_str(&rest);
            return out;
        };
        let label = after_open.substr_bytes(0, close_bracket);
        let tail = after_open.substr_bytes(close_bracket + 1, after_open.len());
        out.push_str(&rest.substr_bytes(0, open));
        out.push_str(&label);
        if !tail.starts_with("(") {
            rest = tail;
            continue;
        }
        let Some(close_paren) = tail.find(")") else {
            out.push_str(&tail);
            return out;
        };
        rest = tail.substr_bytes(close_paren + 1, tail.len());
    }
}

/// The first `# ` heading, trimmed; the slug if there is none.
fn extract_title(source: &String, slug: &String) -> String {
    for let line of source.lines() {
        if let Some(rest) = line.trim().strip_prefix("# ") {
            return rest.trim();
        }
    }
    return *slug;
}

/// Rewrite relative `foo.md` / `foo.md#frag` targets to `.html`, leaving absolute
/// URLs and other schemes alone. Operates on rendered `href="…"` values.
pub fn rewrite_md_links(html: &String) -> String {
    let marker = `href="`;
    let mut out = String::new();
    let mut rest = *html;
    loop {
        match rest.find(marker) {
            Some(i) => {
                let cut = i + marker.len();
                out.push_str(&rest.substr_bytes(0, cut));
                let after = rest.substr_bytes(cut, rest.len());
                match after.find(`"`) {
                    Some(j) => {
                        out.push_str(&rewrite_target(&after.substr_bytes(0, j)));
                        rest = after.substr_bytes(j, after.len());
                    },
                    None => {
                        out.push_str(&after);
                        return out;
                    },
                }
            },
            None => {
                out.push_str(&rest);
                return out;
            },
        }
    }
}

fn rewrite_target(url: &String) -> String {
    if url.starts_with("/") || url.contains(":") {
        return *url;
    }
    let [path, frag] = match url.find("#") {
        Some(k) => [
            url.substr_bytes(0, k),
            url.substr_bytes(k, url.len()),
        ],
        None => [*url, String::new()],
    };
    let base = match path.strip_suffix(".md") {
        Some(b) => b,
        None => {
            // Non-Markdown: a same-directory sibling stays; anything reaching out
            // of docs/ resolves to the repo source instead.
            if escapes_dir(&path) {
                return github_source(&path, &frag);
            }
            return *url;
        },
    };
    // AGENTS.md / CLAUDE.md are excluded, and anything outside docs/ has no
    // published page; point both at their GitHub source.
    if path.ends_with("AGENTS.md") || path.ends_with("CLAUDE.md") || escapes_dir(&path) {
        return github_source(&path, &frag);
    }
    return `${base}.html${frag}`;
}

/// True when the relative target leaves its own directory (any `/` after an
/// optional leading `./`), i.e. it does not name a sibling doc.
fn escapes_dir(path: &String) -> bool {
    let p = match path.strip_prefix("./") {
        Some(s) => s,
        None => *path,
    };
    return p.contains("/");
}

fn github_source(path: &String, frag: &String) -> String {
    return `https://github.com/wado-lang/wado/blob/main/${normalize_repo_path(path)}${frag}`;
}

/// Resolve a docs-relative path to its repo-root path (docs/ is the base).
fn normalize_repo_path(path: &String) -> String {
    let mut segs: List<String> = ["docs"];
    for let s of path.split("/") {
        if s == "" || s == "." {
            continue;
        }
        if s == ".." {
            if !segs.is_empty() {
                let _ = segs.pop();
            }
        } else {
            segs.push(s);
        }
    }
    return segs.join("/");
}

use { render_page, render_index } from "./template.wado";
use { Post } from "./post.wado";
use { post } from "./fixture.wado";

test "render_page emits a full page and escapes the title" {
    let html = render_page(&post("hello", "Hi & Co", "2026-07-05", "An intro to Wado"));
    assert html.starts_with("<!doctype html>");
    assert html.contains("<meta name=\"viewport\"");
    assert html.contains("<title>Hi &amp; Co</title>");
    assert html.contains("<h1>Hi &amp; Co</h1>");
    assert html.contains("<span class=\"author\">FUJI Goro</span>");
    assert html.contains("<time>2026-07-05</time>");
    assert html.contains("<p>x</p>");
    assert html.contains("class=\"masthead\"");
    assert html.contains("<footer>");
    assert html.ends_with("</html>\n");
}

test "render_page emits Open Graph and Twitter metadata" {
    let html = render_page(&post("hello", "Hi & Co", "2026-07-05", "An intro to Wado"));
    assert html.contains("<meta property=\"og:type\" content=\"article\" />");
    assert html.contains("<meta property=\"og:title\" content=\"Hi &amp; Co\" />");
    assert html.contains("<meta property=\"og:description\" content=\"An intro to Wado\" />");
    assert html.contains("<meta property=\"og:url\" content=\"https://wado-lang.org/blog/hello.html\" />");
    assert html.contains("<meta property=\"og:image\" content=\"https://wado-lang.org/assets/og-image.svg\" />");
    assert html.contains("<meta property=\"article:published_time\" content=\"2026-07-05\" />");
    assert html.contains("<meta name=\"twitter:card\" content=\"summary_large_image\" />");
    assert html.contains("<link rel=\"canonical\" href=\"https://wado-lang.org/blog/hello.html\" />");
}

test "render_page falls back to the title when no description is set" {
    let html = render_page(&post("hello", "Just a Title", "2026-07-05"));
    assert html.contains("<meta property=\"og:description\" content=\"Just a Title\" />");
}

test "render_page adds a noindex meta for unlisted posts" {
    let html = render_page(&post("draft", "Draft", "2026-07-05", "", false));
    assert html.contains("<meta name=\"robots\" content=\"noindex, nofollow\" />");
}

test "render_index lists published posts newest-first and omits unlisted" {
    let posts: List<Post> = [
        post("b", "B", "2026-02-01"),
        post("a", "A", "2026-03-01"),
        post("d", "Draft", "2026-04-01", "", false),
    ];
    let html = render_index(&posts);
    assert html.contains("<h1 class=\"page-title\">The Wado Blog</h1>");
    assert html.contains("<meta property=\"og:type\" content=\"website\" />");
    assert html.contains("<meta property=\"og:url\" content=\"https://wado-lang.org/blog/\" />");

    let Some(a) = html.find("a.html") else {
        panic("the index does not link a.html");
    };
    let Some(b) = html.find("b.html") else {
        panic("the index does not link b.html");
    };
    assert a < b;
    assert !html.contains("Draft");
}

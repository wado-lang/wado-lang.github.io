//! HTML templates built from the language's template literals plus Marl's HTML
//! escaping helpers. The visual design mirrors the landing page (calligraphic
//! ink-on-paper, vermillion seal accent); the stylesheet is inlined from
//! `style.css` at compile time.

use { escape_text, escape_attr } from "../.tmp/wado/package-marl/src/lib.wado";
use { Post } from "./post.wado";
use { Doc } from "./doc.wado";

global STYLE: String = #include_str("./style.css");
global SITE_NAME: String = "The Wado Blog";
global BLOG_URL: String = "https://wado-lang.org/blog";
global DOCS_URL: String = "https://wado-lang.org/docs";
global OG_IMAGE: String = "https://wado-lang.org/assets/og-image.svg";

/// Per-page metadata driving the document head (SEO + Open Graph / Twitter).
struct PageMeta {
    title: String,
    description: String,
    canonical: String,
    og_type: String,
    published: String = "",
    author: String = "",
    noindex: bool = false,
}

/// The shared document head, up to and including the masthead inside `<main>`.
fn page_head(meta: &PageMeta) -> String {
    let title = escape_attr(meta.title);
    let desc = escape_attr(meta.description);
    let url = escape_attr(meta.canonical);

    let mut out = String::new();
    out.push_str(&"<!doctype html>\n<html lang=\"en\">\n<head>\n");
    out.push_str(&`<meta charset="utf-8" />\n`);
    out.push_str(&`<meta name="viewport" content="width=device-width, initial-scale=1" />\n`);
    out.push_str(&`<title>{escape_text(meta.title)}</title>\n`);
    out.push_str(&`<meta name="description" content="{desc}" />\n`);
    out.push_str(&`<link rel="canonical" href="{url}" />\n`);
    if meta.noindex {
        out.push_str(&`<meta name="robots" content="noindex, nofollow" />\n`);
    }
    out.push_str(&`<meta property="og:type" content="{escape_attr(meta.og_type)}" />\n`);
    out.push_str(&`<meta property="og:site_name" content="{escape_attr(SITE_NAME)}" />\n`);
    out.push_str(&`<meta property="og:title" content="{title}" />\n`);
    out.push_str(&`<meta property="og:description" content="{desc}" />\n`);
    out.push_str(&`<meta property="og:url" content="{url}" />\n`);
    out.push_str(&`<meta property="og:image" content="{OG_IMAGE}" />\n`);
    if !meta.published.is_empty() {
        out.push_str(&`<meta property="article:published_time" content="{escape_attr(meta.published)}" />\n`);
    }
    if !meta.author.is_empty() {
        out.push_str(&`<meta property="article:author" content="{escape_attr(meta.author)}" />\n`);
    }
    out.push_str(&`<meta name="twitter:card" content="summary_large_image" />\n`);
    out.push_str(&`<meta name="twitter:title" content="{title}" />\n`);
    out.push_str(&`<meta name="twitter:description" content="{desc}" />\n`);
    out.push_str(&`<meta name="twitter:image" content="{OG_IMAGE}" />\n`);
    out.push_str(&`<link rel="icon" type="image/png" href="/assets/wado-512.png" />\n`);
    out.push_str(&"<style>\n");
    out.push_str(&STYLE);
    out.push_str(&"</style>\n");
    out.push_str(&"</head>\n<body>\n<main>\n");
    out.push_str(&masthead());
    return out;
}

/// Logo linking home, shared by every page.
fn masthead() -> String {
    let mut out = String::new();
    out.push_str(&`<header class="masthead">`);
    out.push_str(&`<a class="brand" href="/" aria-label="Wado home">`);
    out.push_str(&`<img src="/assets/wado-512.png" alt="" width="52" height="52" />`);
    out.push_str(&`<span class="brand-name">Wado</span></a>`);
    out.push_str(&`</header>\n`);
    return out;
}

/// Seal, license line, and the closing tags, shared by every page.
fn page_foot() -> String {
    let mut out = String::new();
    out.push_str(&`<footer>\n`);
    out.push_str(&`<p><span class="seal" aria-hidden="true"><img src="/assets/wado-512.png" alt="" /></span>`);
    out.push_str(&`MIT License · Copyright © 2026 FUJI Goro (a.k.a. gfx)</p>\n`);
    out.push_str(&`<p><a href="https://github.com/wado-lang/wado">github.com/wado-lang/wado</a></p>\n`);
    out.push_str(&`</footer>\n</main>\n</body>\n</html>\n`);
    return out;
}

pub fn render_page(post: &Post) -> String {
    let description = if post.description.is_empty() { post.title } else { post.description };
    let meta = PageMeta {
        title: post.title,
        description,
        canonical: `{BLOG_URL}/{post.slug}.html`,
        og_type: "article",
        published: post.date,
        author: post.author,
        noindex: !post.index,
    };
    let mut out = page_head(&meta);
    out.push_str(&"<article>\n");
    out.push_str(&`<h1>{escape_text(post.title)}</h1>\n`);
    out.push_str(
        &`<p class="post-meta"><span class="author">{escape_text(post.author)}</span> · <time>{escape_text(post.date)}</time></p>\n`,
    );
    out.push_str(&post.body_html);
    out.push('\n');
    out.push_str(&"</article>\n");
    out.push_str(&page_foot());
    return out;
}

pub fn render_index(posts: &List<Post>) -> String {
    let mut published: List<Post> = [];
    for let p of posts {
        if p.index {
            published.push(*p);
        }
    }
    published.sort_by(|a: &Post, b: &Post| b.date.cmp(&a.date));

    let meta = PageMeta {
        title: SITE_NAME,
        description: "Notes from the Wado programming language project.",
        canonical: `{BLOG_URL}/`,
        og_type: "website",
    };
    let mut out = page_head(&meta);
    out.push_str(&`<h1 class="page-title">The Wado Blog</h1>\n`);
    out.push_str(&`<p class="section-nav"><a href="/docs/">Documentation →</a></p>\n`);
    out.push_str(&`<ul class="post-list">\n`);
    for let p of published {
        let href = `{p.slug}.html`;
        out.push_str(
            &`<li><a href="{escape_attr(href)}">{escape_text(p.title)}</a><time>{escape_text(p.date)}</time></li>\n`,
        );
    }
    out.push_str(&"</ul>\n");
    out.push_str(&page_foot());
    return out;
}

/// A single reference doc. Its body already opens with the level-1 heading, so
/// no separate title is emitted; there is no author/date byline.
pub fn render_doc(doc: &Doc) -> String {
    let meta = PageMeta {
        title: doc.title,
        description: `{doc.title} — Wado documentation.`,
        canonical: `{DOCS_URL}/{doc.slug}.html`,
        og_type: "article",
    };
    let mut out = page_head(&meta);
    out.push_str(&`<article class="doc">\n`);
    out.push_str(&doc.body_html);
    out.push('\n');
    out.push_str(&"</article>\n");
    out.push_str(&page_foot());
    return out;
}

/// The docs landing page: every doc, grouped by kind, sorted within each group.
pub fn render_docs_index(docs: &List<Doc>) -> String {
    let mut reference: List<Doc> = [];
    let mut weps: List<Doc> = [];
    let mut stdlib: List<Doc> = [];
    let mut research: List<Doc> = [];
    let mut other: List<Doc> = [];
    for let d of docs {
        if d.slug == "spec" || d.slug == "cheatsheet" || d.slug == "design-philosophy" {
            reference.push(*d);
        } else if d.slug.starts_with("wep-") {
            weps.push(*d);
        } else if d.slug.starts_with("stdlib-") {
            stdlib.push(*d);
        } else if d.slug.starts_with("research-") {
            research.push(*d);
        } else {
            other.push(*d);
        }
    }
    reference.sort_by(|a: &Doc, b: &Doc| a.slug.cmp(&b.slug));
    weps.sort_by(|a: &Doc, b: &Doc| a.slug.cmp(&b.slug));
    stdlib.sort_by(|a: &Doc, b: &Doc| a.slug.cmp(&b.slug));
    research.sort_by(|a: &Doc, b: &Doc| a.slug.cmp(&b.slug));
    other.sort_by(|a: &Doc, b: &Doc| a.slug.cmp(&b.slug));

    let meta = PageMeta {
        title: "Wado Documentation",
        description: "Specification, standard library, and design proposals for the Wado language.",
        canonical: `{DOCS_URL}/`,
        og_type: "website",
    };
    let mut out = page_head(&meta);
    out.push_str(&`<h1 class="page-title">Documentation</h1>\n`);
    out.push_str(&`<p class="section-nav"><a href="/blog/">← Blog</a></p>\n`);
    out.push_str(&doc_group("Language reference", &reference));
    out.push_str(&doc_group("Wado Evolution Proposals", &weps));
    out.push_str(&doc_group("Standard library", &stdlib));
    out.push_str(&doc_group("Research notes", &research));
    out.push_str(&doc_group("Other", &other));
    out.push_str(&page_foot());
    return out;
}

fn doc_group(heading: String, docs: &List<Doc>) -> String {
    if docs.is_empty() {
        return String::new();
    }
    let mut out = String::new();
    out.push_str(&`<h2 class="doc-group">{escape_text(heading)}</h2>\n`);
    out.push_str(&`<ul class="doc-list">\n`);
    for let d of docs {
        let href = `{d.slug}.html`;
        out.push_str(&`<li><a href="{escape_attr(href)}">{escape_text(d.title)}</a></li>\n`);
    }
    out.push_str(&"</ul>\n");
    return out;
}

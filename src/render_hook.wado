//! Marl's `RenderHook`. Marl inserts each result verbatim, so this file owns
//! its safety. Comments stay in the page, since they hold no secrets.

use { highlight as highlight_wado } from "wado-lang:gale-highlight-wado";
use { escape_text } from "./escape.wado";

export fn highlight(code: String, lang: String) -> String {
    if lang == "wado" {
        return highlight_wado(code);
    }
    return escape_text(code);
}

/// Marl ends a comment at its first `-->`, but a browser also ends one at
/// `--!>`, which would render what follows as markup.
export fn comment(text: String) -> String {
    return `<!--${text.replace("--!>", "--!&gt;")}-->`;
}
